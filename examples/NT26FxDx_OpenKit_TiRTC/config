##############################################################################
# NT26FxDx_OpenKit_TiRTC project configuration
#
# This file is the user-facing switchboard, following the OpenKit/demo
# convention. The project Makefile selects the source tree and includes its
# product-specific configuration.
##############################################################################
APP_VERSION = 01

# APP_VARIANT: select the TiRTC product source tree.
#   lite - TiRTC Lite application under tirtc/
#   pro  - TiRTC Pro application and resource installer under tirtc_pro/
#
APP_VARIANT ?= lite
# BUILD_MODE: select the product build output.
#   app    - build the normal Pro application package
#   assets - build the temporary external-resource installer package
#   full   - build the normal application for the factory-package workflow
#
# For APP_VARIANT=lite, the source tree does not use the Pro resource
# installer; app is the normal Lite build.
BUILD_MODE ?= assets

ifneq ($(filter $(BUILD_MODE),app assets full),$(BUILD_MODE))
$(error Unsupported BUILD_MODE "$(BUILD_MODE)"; use app, assets, or full)
endif

BUILD_COMP_THIRDPART_EN = y
BUILD_THPART_CJSON_ENABLE = y
BUILD_THPART_MBEDTLS_ENABLE = y
BUILD_THPART_OPUS_ENABLE = y

# Board services used by the TiRTC application.
HWDEMO_KEY_EN          ?= y
HWDEMO_LCD_SSD1306_EN  ?= y
HWDEMO_NET_TIME_EN     ?= y
HWDEMO_BINDING_EN      ?= y

# TiRTC runtime and product features.
HWDEMO_TIRTC_EN        ?= y
TIRTC_SMOKE_RUNTIME_EN ?= n
HWDEMO_AI_CHAT_EN      ?= y
HWDEMO_WECHAT_EN       ?= y
HWDEMO_DEV_CHAT_EN     ?= y
HWDEMO_LIVE_TALK_EN    ?= y

TIRTC_MAX_SEND_BUFFER_BYTES ?= 131072
TIRTC_LIBRARY_LOG_LEVEL     ?= 15
TIRTC_TRANSPORT_LOG_LEVEL   ?= 3
TIRTC_TRANSPORT_STATS_EN    ?= 0
TIRTC_AI_PREBUFFER_PACKETS  ?= 1
