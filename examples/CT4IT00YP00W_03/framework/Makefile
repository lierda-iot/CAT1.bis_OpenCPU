CUSTOM_AI_FRAMEWORKD_DIR := $(TOP)/$(CUSTOM_DIR)/framework
CUSTOM_AI_FRAMEWORK_INC := 
CUSTOM_AI_FRAMEWORK_SRCDIR :=
CUSTOM_AI_FRAMEWORK_CSRC :=

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/common/inc
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/common/src

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/audio
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/audio

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/led
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/led

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/battery
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/battery

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/network
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/network

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/powerkey
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/powerkey

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/ai_connect
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/ai_connect

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/ldoPower
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/ldoPower

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/location
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/peripheral/location

CUSTOM_AI_FRAMEWORK_INC += -I $(CUSTOM_AI_FRAMEWORKD_DIR)/resource
CUSTOM_AI_FRAMEWORK_SRCDIR += $(CUSTOM_AI_FRAMEWORKD_DIR)/resource

CFLAGS_INC += $(CUSTOM_AI_FRAMEWORK_INC)
CUSTOM_AI_FRAMEWORK_CSRC = $(foreach dir, $(CUSTOM_AI_FRAMEWORK_SRCDIR), $(wildcard $(dir)/*.c))
CUSTOM_AI_FRAMEWORK_COBJSTEMP := $(patsubst %.c, %.o, $(CUSTOM_AI_FRAMEWORK_CSRC))
CUSTOM_AI_FRAMEWORK_COBJS := $(addprefix $(BUILDDIR)/, $(CUSTOM_AI_FRAMEWORK_COBJSTEMP))

ifeq ($(TOOLCHAIN),GCC)
libusr-y += lib_custom_ai_framework.a

$(BUILDDIR)/lib/libusr/lib_custom_ai_framework.a: $(CUSTOM_AI_FRAMEWORK_COBJS)
	@mkdir -p $(dir $@)
	$(ECHO) AR $@
	$(Q)$(AR) -cr $@ $^
endif
