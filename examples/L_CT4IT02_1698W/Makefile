CUSTOM_CSRC = $(foreach dir, $(CUSTOM_SRC_DIRS), $(wildcard $(dir)/*.c))
CUSTOM_COBJSTEMP += $(patsubst $(TOP)/%.c, %.o, $(CUSTOM_CSRC))
CUSTOM_COBJS := $(addprefix $(BUILDDIR)/, $(CUSTOM_COBJSTEMP))
PP_FILES += $(CUSTOM_COBJS:.o=.pp)

ifeq ($(TOOLCHAIN),GCC)
libusr-y += lib_custom_$(PROJECT).a

.PHONY: FORCE_CUSTOM_ARCHIVE
FORCE_CUSTOM_ARCHIVE:

$(BUILDDIR)/lib/libusr/lib_custom_$(PROJECT).a: $(CUSTOM_COBJS) FORCE_CUSTOM_ARCHIVE
	@mkdir -p $(dir $@)
	$(ECHO) AR $@
	$(Q)rm -f $@
	$(Q)$(AR) -cr $@ $(CUSTOM_COBJS)
endif
