###########################################################
# SDK Version (managed by SDK maintainer, do not modify in project config)
###########################################################
SDK_VERSION_MAJOR := 1
SDK_VERSION_MINOR := 7
SDK_VERSION_PATCH := 1
SDK_VERSION := $(SDK_VERSION_MAJOR).$(SDK_VERSION_MINOR).$(SDK_VERSION_PATCH)

OUT_APP_VERSION ?= appV$(APP_VERSION)
OUT_SDK_VERSION ?= V$(SDK_VERSION)
OUT_SDK_APP_VERSION ?= $(SDK_VERSION)_$(OUT_APP_VERSION)

###########################################################
# customer ctrl
###########################################################
APP_VERSION ?= 01

###########################################################
# secboot ctrl
###########################################################
BUILD_COMP_SECBOOT_EN		?= n

###########################################################
# mem adjust
###########################################################
CODE_REGION_ADJUST ?= 
ifneq ($(CODE_REGION_ADJUST),)
	CFLAGS_DEFS += -DCONFIG_CODE_REGION_ADJUST=$(CODE_REGION_ADJUST)
endif

###########################################################
# driver ctrl
###########################################################
BUILD_DRIVER_LCD_EN ?= n
BUILD_DRIVER_GX8006_EN ?= n
BUILD_DRIVER_BATTERY_EN ?= n
BUILD_DRIVER_WS2812B_EN ?= n
BUILD_DRIVER_CAMERA_EN ?= n
BUILD_DRIVER_TP_EN ?= n
BUILD_DRIVER_CH390_EN ?= n

###########################################################
# tts ctrl
###########################################################
BUILD_COMP_TTS_EN ?= n
# TTS_RESOURCE_TYPE values
# 8k_zh		: 8K采样率+中文（8k sample rate）
# 16k_zh	: 16K采样率+中文（16k sample rate）
# 8k_en		: 8K采样率+英语（8k sample rate + english）
# 16k_en	: 16K采样率+英语（16k sample rate + english）
TTS_RESOURCE_TYPE ?= 8k_zh

###########################################################
# preset file ctrl
# 
# The preset file during the second burn will erase the file
# system, and the original files will disappear. If you want
# your original files to remain, please export the original
# file system image and specify its path, preset file will
# append the files in your image.
# 
# 第二次烧录时的预设文件会擦除文件系统，原来的文件会消失，
# 如果你希望自己原来的文件继续存在，请将原来的文件系统镜像导出，
# 并指定镜像的路径，预设文件会在指定文件系统中追加的文件。
#
# inside LFS : INSIDE_LFS_BIN="export image dir"
# external FLASH LFS : EXT_LFS_BIN="export image dir"
#
# BUILD_PRESET_FILE_INSIDELFS_EN: inside LFS
# BUILD_PRESET_FILE_EXTFLASHLFS_EN: external FLASH LFS
###########################################################
BUILD_COMP_PRESETFILE_EN ?= y

BUILD_PRESET_FILE_INSIDELFS_EN ?= n
BUILD_PRESET_FILE_EXTFLASHLFS_EN ?= n

###########################################################
# thirdparty lib ctrl
###########################################################
BUILD_COMP_THIRDPART_EN ?= n

BUILD_THPART_CJSON_ENABLE ?= y
BUILD_THPART_FREERTOS_ENABLE ?= y
BUILD_THPART_LIB1_ENABLE ?= n
BUILD_THPART_LWIP_ENABLE ?= y
BUILD_THPART_MBEDTLS_ENABLE ?= y
BUILD_THPART_WEBSOCKET_ENABLE ?= n
BUILD_THPART_LVGL_ENABLE ?= n
BUILD_THPART_LIOT_AI_ENABLE ?= n
BUILD_THPART_OPUS_ENABLE ?= n
BUILD_THPART_AMR_DECODER_ENABLE ?= n
BUILD_THPART_MP3_ENABLE ?= n
BUILD_THPART_VSIM_ENABLE ?= n
BUILD_THPART_ZLIB_ENABLE ?= n

###########################################################
# user test demo ctrl
###########################################################
# Note: Modifying the following three values will affect the AT+CGMR and ATI command query responses
# - MODEL_TYPE: Module model, e.g., NT26F6D0 (max length: 32 characters)
# - SDK_VERSION: SDK version, e.g., F6D_A_V0101_V1.7.0 (max length: 64 characters)
# - APP_VERSION: Application version, e.g., appV01 (max length: 64 characters)
# Custom length limits: MODEL_TYPE < 32, APP_VERSION < 64, SDK_VERSION < 64
# Modifying the definitions of MODEL_TYPE, APP_VERSION, and SDK_VERSION allows customization of ATI responses
CFLAGS_DEFS += -DMODEL_TYPE=\"$(MODEM)\"
CFLAGS_DEFS += -DAPP_VERSION=\"$(OUT_APP_VERSION)\"
CFLAGS_DEFS += -DSDK_VERSION=\"$(OUT_SDK_VERSION)\"
CFLAGS_DEFS += -DCGRM_VERSION=\"$(OUT_SDK_APP_VERSION)\"
