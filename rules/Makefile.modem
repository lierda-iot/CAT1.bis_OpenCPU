
F6B_A_SUPPORT_MODEMS := NT26FCNB60WNA 
F6D_A_SUPPORT_MODEMS := NT26FCND60NNA NT26FEUD60NNA NT26F6D0 NT26F6D0_EU NT26F6D0_LA NT26F6D0_NA
F7B_A_SUPPORT_MODEMS := NT26FCNB70WNA
F9D_A_SUPPORT_MODEMS := NT26F9D0
K2B_A_SUPPORT_MODEMS := NT26K2B1 NT26K2B3
K2E_A_SUPPORT_MODEMS := NT26K2E0 NT26K2E1_0G NT26K2E0_0G
K2F_A_SUPPORT_MODEMS := NT26KCNF20NNA
F6D_GL_SUPPORT_MODEMS := NT26F6D0_GL
F6C_A_SUPPORT_MODEMS := NT26F6C0
F6D_LGU_SUPPORT_MODEMS := NT26F6D1
K2B_LGU_SUPPORT_MODEMS := NT26KCNF20NNK

MODEMPKG_LIST  := F6B_A F6D_A F7B_A F9D_A K2B_A K2E_A K2F_A F6D_GL F6C_A F6D_LGU K2B_LGU K2E_LGU K2F_LGU \
                  K2B_LGU

ifeq ($(MODEM),)
$(error 请传入模组型号参数!)
endif

# 遍历所有底包配置，匹配模组型号
MODEMPKG_TMP := UNKNOWN
$(foreach pkg, $(MODEMPKG_LIST), \
    $(if $(filter $(MODEM), $($(pkg)_SUPPORT_MODEMS)), \
        $(eval MODEMPKG_TMP := $(pkg)) \
    ) \
)

ifeq ($(MODEMPKG),)
MODEMPKG := $(MODEMPKG_TMP)
endif

ifeq ($(MODEMPKG), UNKNOWN)
$(error $(MODEM) No matching base package found!)
endif
